{
  "name": "dsh-nai-imagegen",
  "description": "NovelAI 文生图插件：侧栏面板管理凭据与默认参数，宿主半侧注册 nai_* 工具直连 NovelAI 图像 API，出图落盘后由 Agent 在正文里内联显示。",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "NovelAI 出图",
      "en": "NovelAI"
    },
    "icon": "generate-image",
    "contributes": {
      "composer.strip": [
        {
          "id": "nai-balance",
          "icon": "coin",
          "panel": "novelai"
        }
      ],
      "panels": [
        {
          "id": "novelai",
          "title": {
            "zh": "NovelAI",
            "en": "NovelAI"
          },
          "icon": "generate-image",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        },
        {
          "id": "novelai-studio",
          "title": {
            "zh": "生图工作台",
            "en": "Studio"
          },
          "icon": "generate-image",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        }
      ],
      "composer.actions": [
        {
          "id": "nai-writer",
          "label": {
            "zh": "AI 写词",
            "en": "AI Write"
          },
          "icon": "lightbulb"
        }
      ]
    },
    "wants": [
      "draft"
    ]
  },
  "scripts": {
    "verify": "node tests/verify.mjs",
    "install:profile": "node install.mjs",
    "install:profile:apply": "node install.mjs --apply",
    "uninstall:profile": "node install.mjs --uninstall --apply"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kalinkamineral/dsh-nai-imagegen.git"
  },
  "homepage": "https://github.com/kalinkamineral/dsh-nai-imagegen",
  "bugs": {
    "url": "https://github.com/kalinkamineral/dsh-nai-imagegen/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "novelai",
    "image-generation",
    "plugin"
  ]
}
